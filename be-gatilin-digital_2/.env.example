# Copia este archivo como .env y ajusta los valores.
# En producción (Coolify) solo hacen falta las 3 primeras.

# ---------- Obligatorias ----------
# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:tu_clave@localhost:5432/gatilin_db

# URL pública única de la app (web + API en el mismo dominio).
# En desarrollo con "npm run dev" (web :3000 y API :5000 por separado) usa la de la web.
APP_URL=http://localhost:3000

# Secreto largo y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor no arranca si falta o es muy corto.
JWT_SECRET=cambia_esto_por_un_secreto_largo

# ---------- Opcionales ----------
# Datos de demostración: con DEMO_DATA=true se cargan al arrancar SOLO si la base está vacía
DEMO_DATA=false
# Contraseña de las cuentas demo (mínimo 8 caracteres). Por defecto: Demo2026!
DEMO_PASSWORD=

# Detrás de un proxy (Coolify/Traefik, Nginx, Cloudflare) pon 1 para leer la IP real.
# En producción ya vale 1 por defecto.
TRUST_PROXY=0

# ---------- Avanzadas (normalmente no hacen falta) ----------
# Puerto (en Docker ya es 3000). En desarrollo la API usa 5000.
PORT=5000
# Pruebas automáticas (npm test). Por defecto: la base de DATABASE_URL con sufijo _test. ¡Se borra en cada prueba!
# DATABASE_URL_TEST=postgresql://postgres:tu_clave@localhost:5432/gatilin_db_test
# DATABASE_SSL=true            # si tu proveedor de PostgreSQL exige SSL
# MIGRATE_ON_START=true        # aplica migraciones al arrancar
# ADMIN_PASSWORD=              # admin inicial de "npm run db:setup" (si falta, se genera una)
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= / VAPID_SUBJECT=   # notificaciones push (npx web-push generate-vapid-keys)
# VOTOS_POR_IP_DIA=15
