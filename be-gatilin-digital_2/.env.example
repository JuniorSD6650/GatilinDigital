# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=5000
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gatilin_db
# Base de datos aparte para las pruebas automáticas (npm test). ¡Se borra en cada prueba!
DB_NAME_TEST=gatilin_test

# OBLIGATORIO: secreto largo y aleatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor no arranca si falta o es muy corto.
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=7d

# Contraseña del admin inicial que crea createAdmin.js (cámbiala al instalar)
ADMIN_PASSWORD=

# Detrás de un proxy (Nginx, cPanel, Cloudflare) pon 1 para leer la IP real
TRUST_PROXY=0

# URL pública única (web + API en el mismo dominio). En producción basta con esta:
# CORS_ORIGIN, FRONTEND_URL y PUBLIC_API_URL toman su valor si no se definen.
APP_URL=

# URLs públicas por separado (solo si web y API están en dominios distintos,
# p. ej. en desarrollo con "npm run dev")
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# Carpeta del frontend exportado (next build -> out/). Por defecto usa
# ../fe-gatilin-digital_2/out si existe; en Docker es /app/web.
# FRONTEND_DIR=

# Aplica las migraciones al arrancar (pon false para desactivarlo)
MIGRATE_ON_START=true

# Datos de demostración: con DEMO_DATA=true se cargan al arrancar SOLO si la base está vacía
DEMO_DATA=false
DEMO_PASSWORD=

# Notificaciones push. Genera las claves con: npx web-push generate-vapid-keys
# Si quedan vacías, las notificaciones se desactivan sin afectar al resto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gatilin.digital

# Votos máximos por conexión (IP), por cofradía y por día
VOTOS_POR_IP_DIA=15
